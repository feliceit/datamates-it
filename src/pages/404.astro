---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina non trovata" noindex>
  <section class="container-dm max-w-3xl py-20 sm:py-28">
    <p class="kicker">Errore 404</p>
    <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">Questo pixel non è scattato.</h1>
    <p class="mt-6 text-lg text-muted">La pagina che cerchi non esiste o è stata spostata.</p>
    <a href="/" class="btn-primary mt-10">Torna alla home</a>
  </section>
</BaseLayout>
