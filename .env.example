# URL "action" del form di iscrizione Brevo (Brevo → Contatti → Moduli → Condividi → codice HTML incorporato).
# Esempio: https://xxxxxxxx.sibforms.com/serve/MUIFA...
# In produzione va impostato come variabile del repository GitHub (Settings → Secrets and variables → Actions → Variables).
PUBLIC_BREVO_FORM_URL=

# ID del container Google Tag Manager (formato GTM-XXXXXXX). Se resta vuoto, GTM non viene caricato.
# In produzione va impostato come variabile del repository GitHub, come sopra.
PUBLIC_GTM_ID=
